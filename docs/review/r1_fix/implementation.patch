++@dataclass
++class TrendController:
++    zeta: float = 0.9
++    horizon: int = 50
++    deterioration: float = 6.0
++    floor: float = 1e-6
++    age: int = 0
++    ema: Optional[float] = None
++    best: Optional[float] = None
++    resets: int = 0

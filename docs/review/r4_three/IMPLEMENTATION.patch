+
+    def test_auxiliary_known_flips_Brier_and_no_feedback(self):
+        q=torch.full((1,2,512,512),.2);qs=q.clone();qs[:,:,0,0]=.8;mask=torch.zeros_like(q);mask[:,:,0,0]=1
+        allowed=torch.zeros_like(q,dtype=torch.bool);allowed[:,:,0,0]=True

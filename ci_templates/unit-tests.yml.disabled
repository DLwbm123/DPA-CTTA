name: unit-tests

on:
  push:
  pull_request:

jobs:
  cpu-core:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip
      - run: python -m pip install -e .
      - name: Core and optional-integration tests
        env:
          CUDA_VISIBLE_DEVICES: ""
        run: python -m unittest discover -s tests -v
      - run: git diff --check
